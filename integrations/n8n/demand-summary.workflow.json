{
  "name": "MovieTime · demanda externa (piloto)",
  "active": false,
  "nodes": [
    {
      "id": "poll-clock", "name": "Cada minuto", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2,
      "position": [0, 0], "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] } }
    },
    {
      "id": "poll-events", "name": "Obtener eventos", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [240, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 1000,
      "parameters": {
        "method": "POST", "url": "={{ $vars.MOVIETIME_URL + '/api/automations/integrations' }}",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json", "jsonBody": "{\"command\":\"poll\",\"consumer\":\"demand-summary\"}",
        "options": { "timeout": 12000, "redirect": { "redirect": { "followRedirects": false } } }
      }
    },
    {
      "id": "split-events", "name": "Separar eventos", "type": "n8n-nodes-base.splitOut", "typeVersion": 1,
      "position": [480, 0], "parameters": { "fieldToSplitOut": "data", "options": { "destinationFieldName": "event" } }
    },
    {
      "id": "deliver-event", "name": "Enviar resumen", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [720, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 1000,
      "parameters": {
        "method": "POST", "url": "={{ $vars.DEMAND_TARGET_URL }}",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "Idempotency-Key", "value": "={{ $json.event.id }}" }] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.event.id, version: $json.event.version, correlationId: $json.event.correlationId, type: $json.event.type, aggregateId: $json.event.aggregateId, occurredAt: $json.event.occurredAt, data: $json.event.data }) }}",
        "options": { "timeout": 12000, "redirect": { "redirect": { "followRedirects": false } } }
      }
    },
    {
      "id": "ack-event", "name": "Confirmar recepción", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2,
      "position": [960, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 1000,
      "parameters": {
        "method": "POST", "url": "={{ $vars.MOVIETIME_URL + '/api/automations/integrations' }}",
        "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ command: 'acknowledge', consumer: 'demand-summary', eventId: $('Separar eventos').item.json.event.id, token: $('Separar eventos').item.json.event.token }) }}",
        "options": { "timeout": 12000, "redirect": { "redirect": { "followRedirects": false } } }
      }
    }
  ],
  "connections": {
    "Cada minuto": { "main": [[{ "node": "Obtener eventos", "type": "main", "index": 0 }]] },
    "Obtener eventos": { "main": [[{ "node": "Separar eventos", "type": "main", "index": 0 }]] },
    "Separar eventos": { "main": [[{ "node": "Enviar resumen", "type": "main", "index": 0 }]] },
    "Enviar resumen": { "main": [[{ "node": "Confirmar recepción", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "executionTimeout": 240, "timezone": "America/Panama",
    "saveDataErrorExecution": "none", "saveDataSuccessExecution": "none", "saveManualExecutions": false, "saveExecutionProgress": false },
  "pinData": {}
}
