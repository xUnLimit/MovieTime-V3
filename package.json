{
  "name": "movietime-pty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "node scripts/build-verification.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "security:static": "eslint --max-warnings=0",
    "security:audit:prod": "node scripts/security-audit.mjs --production",
    "security:audit:all": "node scripts/security-audit.mjs --all",
    "typecheck:app": "tsc --noEmit --pretty false",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit --pretty false",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage",
    "coverage:diff": "node scripts/check-diff-coverage.mjs",
    "test:browser": "node scripts/run-browser-gate.mjs",
    "test:e2e": "node scripts/run-browser-gate.mjs --grep @smoke",
    "test:a11y": "node scripts/run-browser-gate.mjs --grep @a11y",
    "test:performance": "node scripts/run-browser-gate.mjs --grep @performance",
    "env:validate": "tsx scripts/validate-env.ts",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "secrets:scan:all": "node scripts/scan-secrets.mjs --all",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "quality:fast": "npm run secrets:scan && npm run lint && npm run typecheck && npm test -- --run",
    "quality:full": "npm run secrets:scan:all && npm run security:audit:prod && npm run security:audit:all && npm run security:static && npm run typecheck && npm run migrate:lint && npm run test:coverage && npm run coverage:diff && npm run build:verify && npm run test:e2e && npm run test:a11y && npm run test:performance",
    "release:check": "npm run quality:full",
    "migrate:lint": "node scripts/validate-migration-safety.mjs",
    "migrate:validate": "tsx scripts/validate-supabase-migration.ts",
    "notifications:verify": "tsx scripts/verify-notification-integrity.ts",
    "supabase:reset:dry": "tsx scripts/reset-supabase-staging.ts",
    "supabase:reset": "tsx scripts/reset-supabase-staging.ts --confirm=RESET_SUPABASE_STAGING"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.100.13",
    "@tanstack/react-query-devtools": "^5.100.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "lucide-react": "^0.563.0",
    "next": "^16.3.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^27.4.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
