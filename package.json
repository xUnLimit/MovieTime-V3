{
  "name": "movietime-pty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "node scripts/build-verification.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "security:static": "eslint --max-warnings=0",
    "security:audit:prod": "node scripts/security-audit.mjs --production",
    "security:audit:all": "node scripts/security-audit.mjs --all",
    "typecheck:app": "tsc --noEmit --pretty false --tsBuildInfoFile .next/cache/tsconfig-native.tsbuildinfo",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit --pretty false",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --run --coverage",
    "coverage:diff": "node scripts/check-diff-coverage.mjs",
    "test:browser": "node scripts/run-browser-gate.mjs --project=chromium",
    "test:e2e": "node scripts/run-browser-gate.mjs --project=chromium --grep @smoke",
    "test:a11y": "node scripts/run-browser-gate.mjs --project=chromium --grep @a11y",
    "test:performance": "node scripts/run-browser-gate.mjs --project=chromium --grep @performance",
    "test:lighthouse": "node scripts/run-lighthouse-gate.mjs",
    "env:validate": "tsx scripts/validate-env.ts",
    "design:check": "node scripts/check-design-tokens.mjs",
    "dead-code": "knip --no-progress",
    "prepare": "node scripts/install-git-hooks.mjs",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "module-size": "node scripts/check-module-size.mjs",
    "coverage:baseline": "node scripts/check-coverage-baseline.mjs",
    "ci:parity": "node scripts/check-ci-parity.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e:auth": "node scripts/run-auth-gate.mjs",
    "test:db": "supabase test db",
    "test:mutation": "stryker run",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "secrets:scan:all": "node scripts/scan-secrets.mjs --all",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json",
    "quality:fast": "npm run secrets:scan && npm run design:check && npm run dead-code && npm run arch:check && npm run module-size && npm run ci:parity && npm run lint && npm run typecheck && npm test -- --run",
    "quality:full": "npm run secrets:scan:all && npm run design:check && npm run dead-code && npm run arch:check && npm run module-size && npm run ci:parity && npm run security:audit:prod && npm run security:audit:all && npm run security:static && npm run typecheck && npm run migrate:lint && npm run test:coverage && npm run coverage:baseline && npm run coverage:diff && npm run build:verify && npm run test:e2e && npm run test:a11y && npm run test:performance && npm run test:lighthouse",
    "release:check": "npm run quality:full",
    "migrate:lint": "node scripts/validate-migration-safety.mjs",
    "migrate:validate": "tsx scripts/validate-supabase-migration.ts",
    "notifications:verify": "tsx scripts/verify-notification-integrity.ts",
    "supabase:reset:dry": "tsx scripts/reset-supabase-staging.ts",
    "supabase:reset": "tsx scripts/reset-supabase-staging.ts --confirm=RESET_SUPABASE_STAGING"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-avatar": "1.2.7",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-progress": "1.1.17",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "imapflow": "2.2.10",
    "lucide-react": "1.52.0",
    "mailparser": "3.9.36",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mailparser": "^3.9.0",
    "@types/node": "24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "chrome-launcher": "^1.2.2",
    "dependency-cruiser": "^18.5.0",
    "dotenv": "18.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-security": "4.2.0",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.2",
    "knip": "6.40.0",
    "lighthouse": "^13.5.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "qs": "^6.16.0",
    "seroval": "1.6.8",
    "seroval-plugins": "1.6.8"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
