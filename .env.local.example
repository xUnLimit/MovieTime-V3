# Aplicacion
NEXT_PUBLIC_APP_NAME=MovieTime PTY
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_SW_DEV=false

# Supabase: obtenerlas en Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Solo servidor/scripts. Nunca usar NEXT_PUBLIC_ ni exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Push web (opcionales en desarrollo; necesarios para notificaciones push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Proteccion de endpoints cron (opcional en desarrollo)
CRON_SECRET=
PUSH_CRON_SECRET=

# WhatsApp Cloud API (solo servidor). Con token, desde local se envian mensajes
# REALES con el numero del negocio y se guardan en la base configurada arriba.
# Token: Meta Business > Usuarios del sistema > Generar token (app MovieTime PTY,
# permisos whatsapp_business_messaging y whatsapp_business_management).
# No dejar ninguna de estas variables vacia: un valor vacio no pasa la validacion
# y el servidor no arranca. Descomentar solo las que tengan valor.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Cuenta de WhatsApp Business: la usa "Sincronizar con Meta" en el editor de plantillas.
# WHATSAPP_WABA_ID=
# Solo los usa el webhook de Meta, que no llega a localhost.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Minimo 16 caracteres. Protege el cron de avisos automaticos; debe coincidir con el Vault de Supabase.
# WHATSAPP_AUTO_NOTICES_SECRET=

# Pagos Yappy por IMAP (solo servidor). Gmail + contrasena de aplicacion de Google.
# Con las tres, "Sincronizar ahora" en /pagos-yappy lee el buzon real.
# YAPPY_IMAP_USER=
# YAPPY_IMAP_PASSWORD=
# Buzon donde Proton reenvia los correos de Netflix (Gmail + contrasena de aplicacion); lo usa el bot de codigos.
# NETFLIX_IMAP_USER=
# NETFLIX_IMAP_PASSWORD=
# Minimo 16 caracteres; en local basta un valor aleatorio (el cron no llega a localhost).
# YAPPY_SYNC_SECRET=

# Automatizaciones opcionales, solo servidor. Sin estas claves la integración
# permanece desactivada.
# AUTOMATION_INTEGRATION_TOKEN=
# AUTOMATION_INTEREST_TEMPLATE=
# Bandera de servidor (apagada por defecto): permite editar el flujo de compras como
# bloques cerrados del lienzo del recorrido. Solo el valor exacto "true" la enciende.
# COMMERCE_FLOW_CANVAS_ENABLED=
# Bandera de servidor (apagada por defecto): permite publicar condiciones (cliente con servicio,
# cupo en el catalogo) y datos del pedido ({{pedido_total}}...) en los textos del recorrido.
# Solo el valor exacto "true" la enciende. La version anterior de la app no entiende estos campos.
# FLOW_EXTENSIONS_ENABLED=
# WHATSAPP_INBOX_CRON_SECRET=
# YAPPY_PAYMENT_INSTRUCTIONS=
